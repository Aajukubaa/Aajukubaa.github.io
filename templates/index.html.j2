<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ site.title }}</title>

    <meta name="description" content="{{ site.description }}" />

    <meta property="og:title" content="{{ site.title }}" />
    <meta property="og:description" content="{{ site.description }}" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ site.url }}" />
    <meta property="og:image" content="{{ site.og_image }}" />

    <link rel="icon" type="image/png" href="{{ site.favicon }}">

    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Inter:wght@300;400;500;600;700;800;900&family=Syne:wght@700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="assets/style.css?v={{ asset_versions['style.css'] }}">
</head>
<body>

    <div id="custom-cursor"></div>

    <!-- Lives outside #detail-view on purpose: that element has a CSS
         transform on it for its open/close animation, and a transform
         creates a new containing block for position:fixed descendants —
         which meant this button was "fixed" relative to the modal, not
         the viewport, and could drift on scroll on some browsers
         (iOS Safari especially). Living at the body level and toggling
         visibility via body.modal-active sidesteps that entirely. -->
    <button id="global-close-btn" class="close-btn" data-action="close-detail" aria-label="Close Modal">✕</button>

    <nav class="top-nav-container">
        {% for tab in nav_tabs %}
        <button class="nav-tab{% if loop.first %} active{% endif %}" data-target="{{ tab.id }}">{{ tab.label }}</button>
        {% endfor %}
        <button class="nav-tab search-toggle" id="search-toggle" aria-label="Search (Ctrl+K)" title="Search (Ctrl+K)">🔍</button>
    </nav>

    <div id="tab-overview" class="tab-content active-view">
        <main class="hero-container">
            <h1 class="hero-title">
                {% for line in hero.lines %}
                <span>{{ line }}</span>
                {% endfor %}
            </h1>
        </main>

        <section class="intro-banner">
            <p>{{ hero.intro }}</p>
        </section>

        <section class="specs-strip">
            {% for spec in specs %}
            <div class="spec-item">
                <div class="spec-value">{{ spec.value }}</div>
                <div class="spec-label">{{ spec.label }}</div>
            </div>
            {% endfor %}
        </section>

        <section class="current-status-section">
            <div class="current-status-card">
                <span class="card-pill">Current Status</span>
                <h2>What I'm doing now</h2>
                <p>{{ now }}</p>
            </div>
        </section>

        <section class="connect-section">
            <div style="max-width: 1300px; margin: 0 auto 30px auto; padding: 0 10px;">
                <h2 class="section-header-title">Connect with <span class="kabir-cursive">Kabir</span></h2>
                <p class="section-subtitle" style="margin-bottom: 25px;">Official profiles, channels, and direct contacts.</p>
            </div>

            <div class="connect-grid">
                {% for link in connect_links %}
                <a href="{{ link.url }}"{% if not link.url.startswith('mailto:') %} target="_blank"{% endif %} class="connect-card">
                    <div class="connect-icon">{{ link.icon }}</div>
                    <div class="connect-details"><h4>{{ link.name }}</h4><p>{{ link.desc }}</p></div>
                    <div class="connect-arrow">↗</div>
                </a>
                {% endfor %}
            </div>
        </section>
    </div>

    <div id="tab-domains" class="tab-content">
        <section class="section-container" style="padding-top: 40px;">
            <h2 class="section-header-title"><span class="kabir-cursive">Kabir</span>'s Domain</h2>
            <p class="section-subtitle">Hover over any card to expand quick specs or click to inspect full details.</p>

            <div class="domain-grid-wrapper">
                <div class="domain-grid">
                    {% for card in domain_cards %}
                    <div class="pro-card" id="{{ card.category }}" tabindex="0" role="button" aria-label="Inspect {{ card.title }} Profile" data-category="{{ card.category }}">
                        <span class="card-pill">{{ card.pill }}</span>
                        <div>
                            <h3>{{ card.title }}</h3>
                            {% if card.image %}
                            <div class="media-placeholder">
                                <img id="{{ card.image.id }}" src="{{ card.image.src }}" alt="{{ card.image.alt }}" loading="lazy">
                            </div>
                            {% endif %}
                            <div class="card-preview">
                                <p>{{ card.preview }}</p>
                                <span class="card-action-btn">Inspect Profile →</span>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </section>
    </div>

    <div id="tab-projects" class="tab-content">
        <section class="section-container" style="padding-top: 40px;">
            <h2 class="section-header-title">Highlight Projects</h2>
            <p class="section-subtitle">A deep dive into recent tournaments, leadership roles, and technical builds.</p>

            <div class="highlight-grid">
                {% for proj in highlight_projects %}
                <div class="highlight-card" id="{{ proj.category }}" tabindex="0" role="button" aria-label="View {{ proj.title }} Details" data-category="{{ proj.category }}">
                    <div>
                        <span class="card-pill">{{ proj.pill }}</span>
                        <h3>{{ proj.title }}</h3>
                        <p>{{ proj.desc }}</p>
                        <div style="margin-top: 20px;" class="card-action-default">{{ proj.cta }} <span>→</span></div>
                    </div>
                    {% if proj.image %}
                    <div class="media-placeholder"><img{% if proj.image.id %} id="{{ proj.image.id }}"{% endif %} src="{{ proj.image.src }}" alt="{{ proj.image.alt }}" loading="lazy"></div>
                    {% else %}
                    <div class="media-placeholder">Photo coming soon</div>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        </section>
    </div>

    <div id="tab-archive" class="tab-content">
        <section class="section-container" style="padding-top: 40px;">
            <h2 class="section-header-title">Creative Archive</h2>
            <p class="section-subtitle">Development scripts, presentation slide decks, and design portfolios.</p>

            <div class="tiles-grid">
                {% for item in creative_archive %}
                <div class="standard-card" id="{{ item.category }}" tabindex="0" role="button" aria-label="View {{ item.title }}" data-category="{{ item.category }}">
                    <span class="card-pill">{{ item.pill }}</span>
                    <div>
                        <h3>{{ item.title }}</h3>
                        {% if item.image %}
                        <div class="media-placeholder"><img src="{{ item.image.src }}" alt="{{ item.image.alt }}" loading="lazy"></div>
                        {% else %}
                        <div class="media-placeholder">Photo coming soon</div>
                        {% endif %}
                        <p style="color:#86868b; font-size:0.9rem; margin:0;">{{ item.desc }}</p>
                    </div>
                    <div style="margin-top: 15px;" class="card-action-default">{{ item.cta }} <span>→</span></div>
                </div>
                {% endfor %}
            </div>
        </section>
    </div>

    <div id="detail-view">
        <div class="bento-hero">
            <div class="bento-header-wrapper">
                <div id="detail-badge" class="card-pill">PRO DETAIL</div>
                <h1 id="detail-title">TITLE</h1>
            </div>

            <div id="detail-bento-grid" class="bento-grid"></div>
        </div>

        <div class="bento-deep-content">
            <div id="detail-content">Loading content...</div>
        </div>
    </div>

    <div id="shortcuts-modal" data-action="close-shortcuts" style="display:none; position:fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(0,0,0,0.9); z-index:100000; justify-content:center; align-items:center;">
        <div class="shortcuts-box" style="background:#141416; border:2px solid #2e2e34; border-radius:24px; padding:40px; max-width:500px; width:90%;">
            <h3 style="color:#fff; margin-top:0; font-size:1.5rem;">Keyboard Shortcuts</h3>
            <div class="shortcut-row" style="display:flex; justify-content:space-between; padding:10px 0; border-bottom:2px solid #222226; font-size:0.95rem;"><span>Switch to Overview</span><span><kbd class="kbd">1</kbd></span></div>
            <div class="shortcut-row" style="display:flex; justify-content:space-between; padding:10px 0; border-bottom:2px solid #222226; font-size:0.95rem;"><span>Switch to Domains</span><span><kbd class="kbd">2</kbd></span></div>
            <div class="shortcut-row" style="display:flex; justify-content:space-between; padding:10px 0; border-bottom:2px solid #222226; font-size:0.95rem;"><span>Switch to Projects</span><span><kbd class="kbd">3</kbd></span></div>
            <div class="shortcut-row" style="display:flex; justify-content:space-between; padding:10px 0; border-bottom:2px solid #222226; font-size:0.95rem;"><span>Switch to Archive</span><span><kbd class="kbd">4</kbd></span></div>
            <div class="shortcut-row" style="display:flex; justify-content:space-between; padding:10px 0; border-bottom:2px solid #222226; font-size:0.95rem;"><span>Search the Site</span><span><kbd class="kbd">Ctrl</kbd> <kbd class="kbd">K</kbd></span></div>
            <div class="shortcut-row" style="display:flex; justify-content:space-between; padding:10px 0; border-bottom:2px solid #222226; font-size:0.95rem;"><span>Close Modal / Overlay</span><span><kbd class="kbd">Esc</kbd></span></div>
            <button class="interactive-btn" style="width:100%; margin-top:20px;" data-action="close-shortcuts">Got It</button>
        </div>
    </div>

    <div id="search-modal" data-action="close-search">
        <div class="search-box">
            <div class="search-input-row">
                <span class="search-icon">🔍</span>
                <input type="text" id="search-input" class="search-input" placeholder="Search the site…" autocomplete="off" spellcheck="false">
                <button class="search-close" data-action="close-search" aria-label="Close search">✕</button>
            </div>
            <div id="search-results" class="search-results"></div>
            <p class="search-hint">↑↓ to navigate · Enter to open · Esc to close</p>
        </div>
    </div>

    <div id="lightbox" data-action="close-lightbox">
        <button class="lightbox-close" data-action="close-lightbox" aria-label="Close">✕</button>
        <button class="lightbox-nav lightbox-prev" data-action="lightbox-prev" aria-label="Previous">‹</button>
        <img id="lightbox-img" src="" alt="">
        <video id="lightbox-video" controls playsinline></video>
        <button class="lightbox-nav lightbox-next" data-action="lightbox-next" aria-label="Next">›</button>
    </div>

    <script type="application/json" id="categories-data">{{ categories_json | safe }}</script>
    <script src="assets/main.js?v={{ asset_versions['main.js'] }}"></script>
    <script src="assets/chess-dashboard.js?v={{ asset_versions['chess-dashboard.js'] }}"></script>
    <script src="assets/search.js?v={{ asset_versions['search.js'] }}"></script>

    <footer class="site-footer">
        <p>This website was made on GitHub Pages with the <strong>help</strong> of artificial intelligence.</p>
    </footer>
</body>
</html>
